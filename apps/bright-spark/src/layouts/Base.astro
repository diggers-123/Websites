---
import '@/styles/theme.css';
import Head from '@site/core/components/Head.astro';
import DemoBanner from '@site/core/components/DemoBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site.config';
interface Props { title?: string; description?: string; image?: string; schema?: unknown[]; noindex?: boolean; hideBookBar?: boolean }
const { title, description, image, schema, noindex, hideBookBar = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><Head {site} {title} {description} {image} {schema} {noindex} /></head>
  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <DemoBanner {site} />
    <Header />
    <main id="main" class="flex-1" tabindex="-1"><slot /></main>
    <Footer />
    {!hideBookBar && (<><div class="sm:hidden fixed bottom-3 inset-x-3 z-40"><a href={site.primaryCta.href} class="btn btn-hi w-full shadow-xl border-ink">{site.primaryCta.label}</a></div><div class="sm:hidden h-[76px]" aria-hidden="true"></div></>)}
    <script>
      import { initReveal, initMobileNav } from '@site/core/components/reveal';
      initReveal();
      initMobileNav({ button: '[data-nav-toggle]', panel: '[data-nav-panel]' });
      // Highlighter swipes draw in when they scroll into view.
      const hls = document.querySelectorAll<HTMLElement>('.hl');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.4 });
        hls.forEach((h) => io.observe(h));
      } else hls.forEach((h) => h.classList.add('is-in'));
    </script>
  </body>
</html>
