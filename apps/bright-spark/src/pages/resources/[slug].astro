---
import Base from '@/layouts/Base.astro';
import { site, resources } from '@/site.config';
import { breadcrumbSchema } from '@site/core';
export function getStaticPaths() { return resources.map((r) => ({ params: { slug: r.slug }, props: { r } })); }
const { r } = Astro.props as { r: (typeof resources)[number] };
const others = resources.filter((x) => x.slug !== r.slug);
const schema = [breadcrumbSchema([{ name: 'Home', url: site.seo.siteUrl }, { name: 'Resources', url: `${site.seo.siteUrl}/resources` }, { name: r.title, url: `${site.seo.siteUrl}/resources/${r.slug}` }]), { '@context': 'https://schema.org', '@type': 'Article', headline: r.title, description: r.summary, author: { '@type': 'Person', name: site.owner?.name }, publisher: { '@type': 'Organization', name: site.name } }];
---
<Base title={r.title} description={r.summary} {schema}>
  <section class="grid-paper border-b-2 border-ink"><div class="mx-auto max-w-3xl px-5 sm:px-8 pt-12 lg:pt-20 pb-12"><nav aria-label="Breadcrumb" class="text-sm text-mute"><a href="/resources" class="underline">Resources</a> / {r.readMins} min read</nav><h1 class="display-lg mt-5">{r.title}</h1><p class="mt-4 text-lg text-ink/80">{r.summary}</p><p class="hand text-xl mt-4">— {site.owner?.name}</p></div></section>
  <article class="mx-auto max-w-3xl px-5 sm:px-8 py-12"><div class="sheet px-6 sm:pl-20 sm:pr-12 py-8">{r.body.map((p) => <p class="leading-8 text-ink/85 mb-8 last:mb-0">{p}</p>)}</div>
    <div class="sticky-note tilt-r mt-12 max-w-md"><p class="hand text-2xl">Want this done with your child?</p><p class="text-sm mt-2">A free twenty-minute call is the quickest way to find out what would help.</p><a href="/book" class="btn btn-ink mt-4">Book a free call</a></div>
  </article>
  <section class="mx-auto max-w-3xl px-5 sm:px-8 pb-16"><p class="eyebrow">More</p><ul class="mt-3 grid sm:grid-cols-2 gap-4 list-none p-0">{others.map((o) => <li><a href={`/resources/${o.slug}`} class="card block p-5 hover:bg-hi/30"><p class="display-sm">{o.title}</p><p class="text-sm text-mute mt-2">{o.readMins} min read</p></a></li>)}</ul></section>
</Base>
