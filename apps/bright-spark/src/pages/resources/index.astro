---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { resources } from '@/site.config';
import { img } from '@/images';
const pics = [['flatlay', 'Exercise books, highlighter and calculator laid out on a desk'], ['online', 'A student in an online lesson at a laptop'], ['kitchen', 'A parent and child working through a workbook at a kitchen table']];
---
<Base title="Resources" description="Free study advice from a Cambridge tutor: how to revise GCSE maths, online vs in-person tutoring, and preparing for the 11+ without the stress.">
  <section class="grid-paper border-b-2 border-ink"><div class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-10 pt-12 lg:pt-20 pb-14"><p class="eyebrow">Resources</p><h1 class="display-xl mt-3">Free advice, <span class="hl">no catch.</span></h1><p class="mt-5 text-ink/80 max-w-xl">The things I say on most assessment calls, written down.</p></div></section>
  <section class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-10 py-14 grid md:grid-cols-3 gap-8">{resources.map((r, i) => <article class="group" data-reveal data-reveal-delay={i * 80}><a href={`/resources/${r.slug}`} class="block"><div class:list={['bg-white p-2 pb-4 shadow-[0_20px_40px_-25px_rgba(29,46,107,0.5)] transition-transform group-hover:rotate-0', i % 2 ? 'rotate-[1.5deg]' : 'rotate-[-1.5deg]']}><Image src={img(pics[i][0])} alt={pics[i][1]} widths={[400, 700]} sizes="(min-width:768px) 33vw, 92vw" class="w-full aspect-[4/3] object-cover" /></div><p class="eyebrow mt-6">{r.readMins} min read</p><h2 class="display-md mt-2 group-hover:underline">{r.title}</h2><p class="mt-3 text-ink/80">{r.summary}</p></a></article>)}</section>
</Base>
