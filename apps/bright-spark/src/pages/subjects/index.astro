---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Note from '@/components/Note.astro';
import { site, subjects } from '@/site.config';
import { img } from '@/images';
---
<Base title="Subjects" description="Maths, physics, chemistry, biology and 11+ tuition — KS3, GCSE, A-level and adult resits. AQA, Edexcel, OCR and IGCSE. Cambridge and online.">
  <section class="grid-paper border-b-2 border-ink"><div class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-10 pt-12 lg:pt-20 pb-14 flex flex-wrap items-end justify-between gap-6"><div><p class="eyebrow">Subjects &amp; levels</p><h1 class="display-xl mt-3">What I <span class="hl">teach.</span></h1><p class="mt-5 text-ink/80 max-w-xl">Maths and the three sciences to A-level, plus 11+ and entrance preparation. All major boards. One tutor, so the method is consistent across subjects.</p></div><Note arrow="left" class="text-ink">most students do two</Note></div></section>
  <section class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-10 py-14 grid gap-8">
    {subjects.map((s, i) => { const svc = site.services.find((x) => x.slug === s.slug)!; return <article class:list={['card overflow-hidden grid md:grid-cols-[320px_1fr] items-stretch', i % 2 && 'md:[&>*:first-child]:order-2']} data-reveal><div class="relative min-h-[220px]"><Image src={img(s.image)} alt={`${s.name} tuition`} widths={[400, 700]} sizes="(min-width:768px) 320px, 100vw" class="absolute inset-0 w-full h-full object-cover" /><span class="absolute top-4 left-4 sticky-note !p-3 !py-2 hand text-xl tilt-l">{svc.price}</span></div><div class="p-6 lg:p-9"><p class="eyebrow">{s.levels.join(' · ')}</p><h2 class="display-md mt-2"><a href={`/subjects/${s.slug}`} class="hover:underline">{s.name}</a></h2><p class="mt-3 text-ink/80">{s.headline}</p><p class="mt-2 text-sm text-mute">{s.boards}</p><ul class="mt-4 flex flex-wrap gap-2 text-sm">{s.topics.slice(0, 4).map((t) => <li class="chip !cursor-default">{t}</li>)}</ul><div class="mt-6 flex gap-3 flex-wrap"><a href={`/subjects/${s.slug}`} class="btn btn-ink">{s.name} in detail</a><a href={`/book?subject=${s.slug}`} class="btn btn-outline">Book a free call</a></div></div></article>; })}
  </section>
</Base>
