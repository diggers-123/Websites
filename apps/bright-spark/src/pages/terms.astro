---
import Legal from '@/layouts/Legal.astro';
import { site } from '@/site.config';
---
<Legal title="Terms" description={`Lesson booking, payment and cancellation terms for ${site.name}.`} reviewed={site.legal.policiesReviewed}>
  <h2>Lessons</h2><p>Lessons are 60 minutes unless agreed otherwise. Weekly lessons are booked as a recurring slot, which is held for you while lessons continue. The free assessment call carries no obligation.</p>
  <h2>Payment</h2><p>Weekly lessons are invoiced monthly in arrears and payable within 7 days by bank transfer. Packs of ten are paid in advance, valid for one term, and refundable pro rata if we stop by mutual agreement.</p>
  <h2>Cancellations</h2><p>{site.faqs.find((f) => f.q.startsWith('What if we need to cancel'))?.a} If the tutor cancels, the lesson is rescheduled or not charged.</p>
  <h2>Homework and progress</h2><p>Progress depends on practice between lessons. Grade outcomes are never guaranteed; the tutor will give an honest view of what is realistic and say so if it changes.</p>
  <h2>Conduct</h2><p>Lessons may be ended, without refund for that lesson, if a student is abusive or persistently disruptive. Parents are told the same day.</p>
  <h2>Business</h2><p>{site.legal.legalName}, {site.address.town} {site.address.postcode}. Sole trader.</p>
</Legal>
