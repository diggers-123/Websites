---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="grid-paper min-h-[60vh] flex items-center"><div class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-10 py-20"><p class="hand text-red text-3xl">✗ see me</p><h1 class="display-xl mt-3">404. Wrong <span class="hl">page.</span></h1><p class="mt-4 text-ink/80 max-w-md">That page doesn't exist. Method marks for trying, though.</p><div class="mt-7 flex gap-3 flex-wrap"><a href="/" class="btn btn-ink">Home</a><a href="/book" class="btn btn-hi border-ink">Book a free call</a></div></div></section>
</Base>
