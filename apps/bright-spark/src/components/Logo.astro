---
interface Props { class?: string; invert?: boolean }
const { class: cls = '', invert = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 font-display font-800 tracking-[-0.03em] leading-none', cls]}>
  <svg width="1.1em" height="1.1em" viewBox="0 0 24 24" aria-hidden="true" class="text-hi"><path d="M12 1l2.2 7.3L22 11l-7.8 2.7L12 23l-2.2-9.3L2 11l7.8-2.7z" fill="currentColor" stroke={invert ? 'none' : 'var(--color-ink)'} stroke-width="1.4" stroke-linejoin="round"/></svg>
  <span>Bright {invert ? <span class="bg-hi text-ink px-1">Spark</span> : <span class="hl-static">Spark</span>}</span>
</span>
