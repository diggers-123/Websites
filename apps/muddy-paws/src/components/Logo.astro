---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`}>
  <svg class="h-[1.8em] w-auto" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22" fill="#1e5f6b" stroke="#4a2b1e" stroke-width="3"/>
    <g fill="#fff5e1"><ellipse cx="24" cy="30" rx="8" ry="6.5"/><circle cx="14" cy="21" r="3.6"/><circle cx="20" cy="15" r="3.6"/><circle cx="28" cy="15" r="3.6"/><circle cx="34" cy="21" r="3.6"/></g>
  </svg>
  <span class="font-display font-700 text-[1.45em] leading-none tracking-tight">Muddy <span class="text-teal">Paws</span></span>
</span>
