---
import Base from '@/layouts/Base.astro';
import Dog from '@/components/Dog.astro';
import { site } from '@/site.config';
import { faqSchema } from '@site/core';
---
<Base title="FAQ" description="Dog grooming questions answered: prices, how long it takes, nervous dogs, matting, vaccinations, how often to groom, and parking in Harrogate." schema={[faqSchema(site.faqs)]}>
  <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 pt-10 lg:pt-16 pb-24 grid lg:grid-cols-[1fr_2fr] gap-10">
    <div><span class="sticker bg-cream">Questions</span><h1 class="display-xl text-teal mt-4">FAQ</h1><div class="w-40 mt-6" aria-hidden="true"><Dog size="m" /></div><p class="mt-4 text-cocoa/75 max-w-xs">Not answered? <a class="underline" href="/contact">Ask Beth</a>.</p></div>
    <div class="grid gap-4">
      {site.faqs.map((f) => (
        <details class="group bubble [&::after]:hidden">
          <summary class="cursor-pointer list-none p-5 flex items-center justify-between gap-5 [&::-webkit-details-marker]:hidden"><span class="display-sm">{f.q}</span><span class="size-9 shrink-0 rounded-full bg-coral border-[3px] border-cocoa grid place-items-center font-display text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="px-5 pb-5 text-cocoa/85">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
