---
import Base from '@/layouts/Base.astro';
---
<Base title="Image credits" description="Image sources for this demonstration website." noindex>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-10 lg:pt-16 pb-24">
    <h1 class="display-lg text-teal">Image credits</h1>
    <p class="mt-6 text-lg text-cocoa/85">Photography on this demonstration site was generated for the project (AI-assisted) and depicts no real people, dogs or premises. Replace with the business's own photography before launch — see the README.</p>
    <p class="mt-4 text-cocoa/70">Dog illustrations are original SVG artwork (src/dogs.ts). Typefaces: Fredoka and Nunito, served locally under the SIL Open Font License.</p>
  </section>
</Base>
