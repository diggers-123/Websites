---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { img } from '@/images';
---
<Base title="About" description="Northgate Motor Works: an independent Stockport garage since 2004. Three technicians, a dedicated MOT bay, free courtesy cars and a habit of showing you the old parts.">
  <section class="bg-pale grid-lines border-b hairline"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 py-10 lg:py-14 grid lg:grid-cols-[1fr_1fr] gap-8 items-center">
    <div class="job-card p-6 sm:p-8"><p class="eyebrow">About · since {site.founded}</p><h1 class="display-xl mt-2">Independent, on purpose.</h1><div class="mt-4 grid gap-3 text-ink/85"><p>Phil left a main dealer in 2004 because he was tired of selling work cars didn't need. Twenty years on, Northgate runs on the opposite idea: tell people what's wrong, show them the part, charge a fair price, and they come back.</p><p>Three technicians, two ramps and a dedicated MOT bay on Lancashire Hill. Dealer-level diagnostic kit for every mainstream make. Two free courtesy cars. A waiting room with decent coffee and a window onto the workshop, because there is nothing to hide.</p></div></div>
    <div class="relative aspect-[4/5] max-h-[520px] rounded-md overflow-hidden"><Image src={img('owner')} alt="Phil Garside at the workshop door" widths={[640, 1024]} sizes="(min-width:1024px) 40vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" /></div>
  </div></section>
  <section class="py-12 lg:py-16"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8"><h2 class="display-lg mb-6">The team</h2><div class="grid md:grid-cols-3 gap-5">{site.team!.map((m) => <article class="job-card overflow-hidden"><div class="relative aspect-[4/3] overflow-hidden">{m.image && <Image src={img(m.image.src)} alt={m.image.alt} widths={[480, 800]} sizes="(min-width:768px) 30vw, 100vw" class="absolute inset-0 w-full h-full object-cover" />}</div><div class="p-5"><h3 class="display-md">{m.name}</h3><p class="eyebrow mt-1">{m.role}</p><p class="mt-2 text-sm text-ink/80">{m.bio}</p></div></article>)}</div></div></section>
  <section class="bg-navy text-white py-12"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-6">{site.credentials?.map((c) => <div class="border-l-2 border-red pl-4"><p class="display-md">{c.label}</p><p class="text-sm text-white/70 mt-1">{c.detail}</p></div>)}</div></section>
  <section class="py-12 lg:py-16"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1fr_1fr] gap-8 items-center"><div class="relative aspect-[3/2] rounded-md overflow-hidden"><Image src={img('reception')} alt="The reception and waiting area with a window onto the workshop" widths={[640, 1024, 1400]} sizes="(min-width:1024px) 48vw, 100vw" class="absolute inset-0 w-full h-full object-cover" /></div><div><h2 class="display-lg">While you wait</h2><ul class="mt-5 grid gap-3 text-ink/85">{['Coffee, Wi-Fi, a sofa and a viewing window', 'Key safe for 7am drop-offs', 'Two free courtesy cars for longer jobs', 'Text when it\'s ready; card payment on collection'].map((t) => <li class="check">{t}</li>)}</ul></div></div></section>
</Base>
