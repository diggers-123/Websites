---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="bg-pale grid-lines min-h-[60vh] flex items-center"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 py-16"><div class="job-card border-t-red p-8 max-w-lg"><span class="chip chip-red">Fault code 404</span><h1 class="display-xl mt-3">Page not found.</h1><p class="mt-3 text-ink/80">Diagnosis: that link doesn't exist. Recommended fix below.</p><div class="mt-5 flex gap-3 flex-wrap"><a href="/" class="btn btn-navy">Home</a><a href="/book" class="btn btn-red">Book online</a></div></div></div></section>
</Base>
