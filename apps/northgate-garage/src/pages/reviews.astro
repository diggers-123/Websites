---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
---
<Base title="Reviews" description="What Stockport drivers say about Northgate Motor Works: honest MOTs, servicing, diagnostics and brakes.">
  <section class="bg-pale grid-lines border-b hairline"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 py-10 lg:py-14 flex flex-wrap items-end justify-between gap-6"><div><p class="eyebrow">Reviews</p><h1 class="display-xl mt-1">4.8 ★ · 406 reviews</h1></div><p class="eyebrow">Fictional reviews for demonstration · Google &amp; Facebook</p></div></section>
  <section class="py-12 lg:py-16"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 lg:grid-cols-3 gap-4">{site.testimonials.map((t, i) => <figure class="job-card p-5 flex flex-col" data-reveal data-reveal-delay={(i % 3) * 70}><p class="mono text-amber tracking-widest" aria-label={`${t.rating} stars`}>{'★'.repeat(t.rating ?? 5)}</p><blockquote class="mt-2 flex-1">“{t.quote}”</blockquote><figcaption class="eyebrow mt-3">{t.name} · {t.context} · {t.source}</figcaption></figure>)}</div></section>
</Base>
