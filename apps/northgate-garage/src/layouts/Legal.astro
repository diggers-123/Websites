---
import Base from './Base.astro';
interface Props { title: string; description: string; reviewed: string }
const { title, description, reviewed } = Astro.props;
---
<Base {title} {description}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-10 lg:py-14"><h1 class="display-lg">{title}</h1><p class="eyebrow mt-2">Last reviewed {reviewed}</p><div class="mt-5 job-card border-t-amber p-4 text-sm"><strong>Template notice.</strong> This document is a starting point based on ICO guidance. It must be reviewed and adapted for the actual business before going live. It is not legal advice.</div><div class="prose-legal mt-8"><slot /></div></section>
</Base>
<style is:global>
  .prose-legal h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; margin: 1.8rem 0 0.5rem; color: var(--color-navy); }
  .prose-legal p, .prose-legal li { font-size: 1rem; line-height: 1.65; margin: 0.5rem 0; }
  .prose-legal ul { padding-left: 1.3rem; list-style: disc; }
  .prose-legal a { text-decoration: underline; }
</style>
