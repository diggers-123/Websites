---
import '@/styles/theme.css';
import Head from '@site/core/components/Head.astro';
import DemoBanner from '@site/core/components/DemoBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site.config';
interface Props { title?: string; description?: string; image?: string; schema?: unknown[]; noindex?: boolean; hideBookBar?: boolean }
const { title, description, image, schema, noindex, hideBookBar = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><Head {site} {title} {description} {image} {schema} {noindex} /></head>
  <body class="min-h-dvh flex flex-col bg-white">
    <a class="skip-link" href="#main">Skip to content</a>
    <DemoBanner {site} />
    <Header />
    <main id="main" class="flex-1" tabindex="-1"><slot /></main>
    <Footer />
    {!hideBookBar && (<>
      <div class="sm:hidden fixed bottom-0 inset-x-0 z-40 grid grid-cols-[1fr_auto] gap-2 p-2 bg-white border-t hairline shadow-[0_-8px_24px_rgba(11,31,58,0.12)]">
        <a href={site.primaryCta.href} class="btn btn-red">Book online</a>
        <a href={`tel:${site.phoneHref}`} class="btn btn-outline" aria-label={`Call ${site.phone}`}>☎</a>
      </div>
      <div class="sm:hidden h-[64px]" aria-hidden="true"></div>
    </>)}
    <script>
      import { initReveal, initMobileNav } from '@site/core/components/reveal';
      document.querySelectorAll('.check').forEach((el) => el.setAttribute('data-reveal', ''));
      initReveal();
      initMobileNav({ button: '[data-nav-toggle]', panel: '[data-nav-panel]' });
    </script>
  </body>
</html>
