---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { events } from '@/content';
import { img } from '@/images';
---
<Base title="Events we cater" description="Wood-fired pizza catering for weddings, private parties, corporate events and festivals across Norfolk and Suffolk. Typical guest numbers, service and spend for each.">
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-10 pt-12 lg:pt-20 pb-10">
    <p class="hand text-kraft text-3xl -rotate-1">four kinds of party</p>
    <h1 class="display-xl text-cream mt-1">Events</h1>
  </section>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-10 pb-24 grid gap-16">
    {events.map((e, i) => (
      <article class:list={['grid lg:grid-cols-2 gap-8 lg:gap-14 items-center', i % 2 && 'lg:[&>*:first-child]:order-2']} data-reveal>
        <a href={`/events/${e.slug}`} class="relative aspect-[3/2] rounded-md overflow-hidden scorch block"><Image src={img(e.cover)} alt={e.coverAlt} widths={[640, 1024, 1400]} sizes="(min-width:1024px) 50vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} /></a>
        <div>
          <h2 class="display-lg text-cream"><a href={`/events/${e.slug}`} class="hover:text-flame">{e.name}</a></h2>
          <p class="mt-3 text-xl text-kraft">{e.strap}</p>
          <p class="mt-5 text-cream/80">{e.intro[0]}</p>
          <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-char-3 pt-4 text-sm">
            <div><dt class="eyebrow text-ash">Guests</dt><dd class="font-display font-700 text-cream mt-1">{e.typical.guests}</dd></div>
            <div><dt class="eyebrow text-ash">Service</dt><dd class="font-display font-700 text-cream mt-1">{e.typical.service}</dd></div>
            <div><dt class="eyebrow text-ash">Typical spend</dt><dd class="font-display font-700 text-cream mt-1">{e.typical.spend}</dd></div>
          </dl>
          <a href={`/events/${e.slug}`} class="btn btn-kraft mt-7">About {e.name.toLowerCase()}</a>
        </div>
      </article>
    ))}
  </section>
</Base>
