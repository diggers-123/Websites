---
import Base from '@/layouts/Base.astro';
---
<Base title="Image credits" description="Image sources for this demonstration website." noindex>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-12 lg:pt-20 pb-24">
    <h1 class="display-lg text-cream">Image credits</h1>
    <p class="mt-6 text-lg text-cream/80">Photography on this demonstration site was generated for the project (AI-assisted) and depicts no real people, events or premises. Replace with the business's own photography before launch — see the README.</p>
    <p class="mt-4 text-cream/60">Typefaces: Bricolage Grotesque, Work Sans and Caveat, served locally under the SIL Open Font License.</p>
  </section>
</Base>
