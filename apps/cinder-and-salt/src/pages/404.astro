---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-10 py-24 min-h-[60vh] flex flex-col justify-center">
    <p class="hand text-kraft text-3xl -rotate-1">404</p>
    <h1 class="display-xl text-cream mt-1">Burnt that one.</h1>
    <p class="mt-5 text-lg text-cream/80 max-w-md">The page doesn't exist. Back to the fire?</p>
    <div class="mt-8 flex gap-3 flex-wrap"><a href="/" class="btn btn-flame">Home</a><a href="/quote" class="btn btn-outline">Get a quote</a></div>
  </section>
</Base>
