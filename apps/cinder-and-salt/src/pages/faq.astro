---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { faqSchema } from '@site/core';
---
<Base title="FAQ" description="Everything people ask before booking wood-fired pizza catering: guest numbers, venue requirements, vegan and gluten-free, rain, travel, deposits." schema={[faqSchema(site.faqs)]}>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-10 pt-12 lg:pt-20 pb-24 grid lg:grid-cols-[1fr_2fr] gap-10">
    <div><p class="hand text-kraft text-3xl -rotate-1">asked a lot</p><h1 class="display-xl text-cream mt-1">FAQ</h1><p class="mt-5 text-cream/75 max-w-xs">Not here? <a class="underline text-kraft" href="/contact">Ask Rosa</a>.</p></div>
    <div class="border-t-2 border-char-3">
      {site.faqs.map((f) => (
        <details class="group border-b-2 border-char-3">
          <summary class="cursor-pointer list-none py-5 flex items-start justify-between gap-5 [&::-webkit-details-marker]:hidden"><span class="display-sm text-cream">{f.q}</span><span class="font-display font-800 text-flame text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="pb-6 text-cream/80 max-w-prose">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
