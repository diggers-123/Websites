---
import '@/styles/theme.css';
import Head from '@site/core/components/Head.astro';
import DemoBanner from '@site/core/components/DemoBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site.config';
interface Props { title?: string; description?: string; image?: string; schema?: unknown[]; noindex?: boolean; hideQuoteTab?: boolean }
const { title, description, image, schema, noindex, hideQuoteTab = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><Head {site} {title} {description} {image} {schema} {noindex} /></head>
  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <DemoBanner {site} />
    <Header />
    <main id="main" class="flex-1" tabindex="-1"><slot /></main>
    <Footer />
    {!hideQuoteTab && (
      <a href="/quote" class="hidden lg:flex fixed right-0 top-1/2 -translate-y-1/2 z-40 bg-flame text-char font-display font-800 px-3 py-5 rounded-l-md quote-tab tracking-wide hover:bg-kraft transition-colors" aria-label="Get an event quote">Get an event quote →</a>
    )}
    {!hideQuoteTab && (
      <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 p-3 bg-char/95 border-t border-char-3"><a href="/quote" class="btn btn-flame w-full">Get an event quote →</a></div>
    )}
    {!hideQuoteTab && <div class="lg:hidden h-[76px]" aria-hidden="true"></div>}
    <script>
      import { initReveal, initMobileNav } from '@site/core/components/reveal';
      initReveal();
      initMobileNav({ button: '[data-nav-toggle]', panel: '[data-nav-panel]' });
    </script>
  </body>
</html>
