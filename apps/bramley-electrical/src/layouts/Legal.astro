---
import Base from './Base.astro';
interface Props { title: string; description: string; reviewed: string }
const { title, description, reviewed } = Astro.props;
---
<Base {title} {description}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-12 lg:py-16">
    <h1 class="display-lg">{title}</h1><p class="label text-steel mt-3">Last reviewed {reviewed}</p>
    <div class="mt-6 bg-yellow border-2 border-graphite p-4 text-sm"><strong>Template notice.</strong> This document is a starting point based on ICO guidance. It must be reviewed and adapted for the actual business before going live. It is not legal advice.</div>
    <div class="prose-legal mt-8"><slot /></div>
  </section>
</Base>
<style is:global>
  .prose-legal h2 { font-family: var(--font-display); text-transform: uppercase; font-weight: 700; font-size: 1.5rem; margin: 2rem 0 0.6rem; }
  .prose-legal p, .prose-legal li { font-size: 1.05rem; line-height: 1.65; margin: 0.6rem 0; }
  .prose-legal ul { padding-left: 1.3rem; list-style: square; }
  .prose-legal a { text-decoration: underline; }
</style>
