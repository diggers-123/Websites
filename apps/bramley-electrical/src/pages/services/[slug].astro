---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { img } from '@/images';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@site/core';
export function getStaticPaths() { return site.services.map((s) => ({ params: { slug: s.slug }, props: { service: s } })); }
const { service } = Astro.props;
const url = `${site.seo.siteUrl}/services/${service.slug}`;
const related = site.testimonials.filter((t) => (t.context ?? '').toLowerCase().includes(service.name.split(' ')[0].toLowerCase().replace('&', '')) || (t.context ?? '').toLowerCase().includes(service.slug.split('-')[0])).slice(0, 2);
const schema = [serviceSchema(site, service, url), breadcrumbSchema([{ name: 'Home', url: site.seo.siteUrl }, { name: 'Services', url: `${site.seo.siteUrl}/services` }, { name: service.name, url }]), ...(service.faqs ? [faqSchema(service.faqs)] : [])];
---
<Base title={`${service.name} in Sheffield`} description={`${service.summary} ${service.price}. Bramley Electrical — registered, insured electricians across Sheffield.`} {schema}>
  <section class="grid-paper border-b-2 border-graphite">
    <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
      <div><p class="label text-steel"><a href="/services" class="hover:underline">Services</a> › {service.category}</p><h1 class="display-xl mt-2">{service.name}</h1><p class="mt-4 text-lg text-graphite/85 max-w-lg">{service.summary}</p><div class="mt-6 flex items-center gap-5 flex-wrap"><span class="tag !text-base">{service.price}</span><a href={`/quote?job=${service.slug}`} class="btn btn-yellow">Get a quote ›</a></div></div>
      {service.image && <div class="relative aspect-[4/3] border-2 border-graphite overflow-hidden"><Image src={img(service.image.src)} alt={service.image.alt} widths={[640, 1024, 1400]} sizes="(min-width:1024px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" /></div>}
    </div>
  </section>
  <section class="py-14 lg:py-20">
    <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[2fr_1fr] gap-10">
      <div>{service.description?.map((p) => <p class="text-[1.08rem] leading-relaxed text-graphite/85 mb-5 max-w-[65ch]">{p}</p>)}
        {service.faqs && <dl class="mt-8 border-t-2 border-graphite">{service.faqs.map((f) => <div class="py-5 border-b-2 border-graphite/15"><dt class="display-sm">{f.q}</dt><dd class="mt-2 text-graphite/80">{f.a}</dd></div>)}</dl>}
      </div>
      <aside class="self-start lg:sticky lg:top-6 grid gap-5">
        <div class="bg-white border-2 border-graphite p-5"><p class="label text-steel">Included</p><ul class="mt-3 grid gap-2">{service.includes?.map((x) => <li class="tick text-sm">{x}</li>)}</ul></div>
        {related.length > 0 && <div class="dashed-box p-5">{related.map((t) => <blockquote class="text-sm mb-3"><p>“{t.quote}”</p><footer class="label text-steel mt-1">{t.name} · {t.context}</footer></blockquote>)}</div>}
        <div class="bg-graphite text-concrete p-5 border-l-4 border-red"><p class="label text-red">Urgent?</p><a class="font-display font-700 text-xl underline" href={`tel:${site.phoneHref}`}>{site.phone}</a></div>
      </aside>
    </div>
  </section>
</Base>
