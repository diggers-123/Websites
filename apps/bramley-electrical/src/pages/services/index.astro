---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { img } from '@/images';
const cats = [...new Set(site.services.map((s) => s.category))];
---
<Base title="Electrical services" description="Rewires, consumer unit upgrades, EV charger installation, EICRs and landlord certificates, lighting and sockets, commercial maintenance — electricians across Sheffield.">
  <section class="grid-paper border-b-2 border-graphite"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-12 lg:py-16"><p class="tag mb-4">Domestic · commercial · testing</p><h1 class="display-xl">Services</h1><p class="mt-4 text-lg text-graphite/85 max-w-xl">Everything from a socket to a full rewire. Fixed prices where the job is predictable, written quotes where it isn't.</p></div></section>
  {cats.map((c) => (
    <section class="py-14 lg:py-20 border-b-2 border-graphite/15">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <h2 class="display-lg mb-8">{c}</h2>
        <div class="grid gap-6">
          {site.services.filter((s) => s.category === c).map((s, i) => (
            <article class:list={['grid md:grid-cols-[2fr_3fr] gap-6 bg-white border-2 border-graphite', i % 2 && 'md:[&>*:first-child]:order-2']} data-reveal>
              <a href={`/services/${s.slug}`} class="relative aspect-[3/2] md:aspect-auto md:min-h-[260px] overflow-hidden">{s.image && <Image src={img(s.image.src)} alt={s.image.alt} widths={[640, 1024]} sizes="(min-width:768px) 40vw, 100vw" class="absolute inset-0 w-full h-full object-cover" />}<span class="tag absolute top-3 left-3">{s.price}</span></a>
              <div class="p-6 flex flex-col"><h3 class="display-md"><a href={`/services/${s.slug}`} class="hover:underline decoration-yellow decoration-4">{s.name}</a></h3><p class="mt-3 text-graphite/85">{s.summary}</p><ul class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">{s.includes?.map((x) => <li class="tick !gap-2 [&::before]:!w-5 [&::before]:!h-5 [&::before]:!text-xs">{x}</li>)}</ul><div class="mt-5 flex gap-3 flex-wrap"><a href={`/services/${s.slug}`} class="btn btn-graphite !py-2 !px-4 !text-sm">Details</a><a href={`/quote?job=${s.slug}`} class="btn btn-yellow !py-2 !px-4 !text-sm">Quote</a></div></div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>
