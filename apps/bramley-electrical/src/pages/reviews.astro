---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
---
<Base title="Reviews" description="What Sheffield customers say about Bramley Electrical: rewires, emergency call-outs, EV chargers, EICRs and consumer units.">
  <section class="grid-paper border-b-2 border-graphite"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-12 lg:py-16 flex flex-wrap items-end justify-between gap-6"><div><p class="tag mb-4">4.9 ★ · 214 reviews (fictional)</p><h1 class="display-xl">Reviews</h1></div><p class="max-w-sm text-graphite/80">Collected on Checkatrade and Google. Fictional for this demonstration site.</p></div></section>
  <section class="py-14 lg:py-20"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {site.testimonials.map((t, i) => <figure class="bg-white border-2 border-graphite p-6 flex flex-col" data-reveal data-reveal-delay={(i % 3) * 70}><p class="font-display font-700 text-yellow-2 tracking-widest text-xl" aria-label={`${t.rating} stars`}>{'★'.repeat(t.rating ?? 5)}</p><blockquote class="mt-3 text-lg leading-snug flex-1">“{t.quote}”</blockquote><figcaption class="mt-4 label text-steel">{t.name} · {t.context}<br /><span class="capitalize">{t.source}</span></figcaption></figure>)}
  </div></section>
</Base>
