---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="grid-paper min-h-[60vh]"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-20"><p class="tag mb-4">404</p><h1 class="display-xl">Circuit not found.</h1><p class="mt-4 text-lg text-graphite/85 max-w-md">That page has tripped. Try the main switch.</p><div class="mt-7 flex gap-3 flex-wrap"><a href="/" class="btn btn-yellow">Home</a><a href="/quote" class="btn btn-outline">Get a quote</a></div></div></section>
</Base>
