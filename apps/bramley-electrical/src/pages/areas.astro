---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
---
<Base title="Areas covered" description="Electricians covering all Sheffield S postcodes: Hillsborough, Ecclesall, Crookes, Nether Edge, Dore, Chapeltown, plus Rotherham, Dronfield and Chesterfield.">
  <section class="grid-paper border-b-2 border-graphite"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-2 gap-10 items-end"><div><p class="tag mb-4">S postcodes</p><h1 class="display-xl">Areas covered</h1></div><p class="text-lg text-graphite/85">Based in Neepsend, so most of Sheffield is twenty minutes away. Emergencies within the hour across the city; planned work in the wider S postcode area.</p></div></section>
  <section class="py-14 lg:py-20"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1fr_1fr] gap-10">
    <div><h2 class="display-md mb-4">Regularly in</h2><ul class="grid grid-cols-2 gap-2">{site.serviceAreas.map((a) => <li class="bg-white border-2 border-graphite px-3 py-2 font-medium">{a}</li>)}</ul></div>
    <div class="dashed-box p-6 self-start"><h2 class="display-md">Check your postcode</h2><label class="label-field mt-4" for="pc">Postcode</label><div class="flex gap-2"><input id="pc" class="field" placeholder="S11 8YA" autocomplete="postal-code" /><button type="button" class="btn btn-yellow !py-2" data-check>Check</button></div><p class="mt-3 font-display font-700 text-lg" data-result aria-live="polite"></p></div>
  </div></section>
  <script>
    import { postcodeInArea } from '@site/core';
    import { site } from '@/site.config';
    const i = document.getElementById('pc') as HTMLInputElement; const r = document.querySelector<HTMLElement>('[data-result]')!;
    const check = () => { const ok = postcodeInArea(i.value, site.postcodePrefixes); r.textContent = !i.value ? '' : ok ? '✓ Yes — we cover that.' : 'Outside our usual area, but ask — larger jobs considered.'; };
    document.querySelector('[data-check]')!.addEventListener('click', check); i.addEventListener('keydown', (e) => e.key === 'Enter' && check());
  </script>
</Base>
