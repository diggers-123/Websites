---
import Base from '@/layouts/Base.astro';
import { site, fixedPrices, emergency } from '@/site.config';
import { faqSchema } from '@site/core';
const gbp = (p: number) => `£${(p / 100).toLocaleString('en-GB')}`;
const pf = site.faqs.filter((f) => /quotes|charge/.test(f.q));
---
<Base title="Prices" description="Fixed prices for common electrical jobs in Sheffield: extra sockets £110, consumer unit £495, EV charger £895, EICR from £160, emergency call-out £120 first hour. VAT included." schema={[faqSchema(pf)]}>
  <section class="grid-paper border-b-2 border-graphite"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-12 lg:py-16"><p class="tag mb-4">Inc. VAT · labour · standard parts</p><h1 class="display-xl">Prices</h1><p class="mt-4 text-lg text-graphite/85 max-w-xl">If your job is on this list, that's the price. If it isn't, the quote is free and in writing.</p></div></section>
  <section class="py-14 lg:py-20">
    <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.4fr_1fr] gap-10 items-start">
      <table class="w-full border-2 border-graphite bg-white">
        <caption class="sr-only">Fixed-price menu</caption>
        <thead><tr class="bg-graphite text-concrete"><th class="text-left p-3 label">Job</th><th class="text-right p-3 label">Price</th></tr></thead>
        <tbody>{fixedPrices.map((m) => <tr class="border-b border-graphite/15 last:border-0 hover:bg-yellow/30"><th scope="row" class="text-left font-medium p-3">{m.job}</th><td class="text-right font-display font-700 text-xl p-3 whitespace-nowrap">{gbp(m.price)}</td></tr>)}</tbody>
      </table>
      <div class="grid gap-5">
        <div class="bg-graphite text-concrete on-dark p-6 border-l-4 border-red"><h2 class="display-md">Emergency call-out</h2><dl class="mt-4 grid gap-2 text-sm"><div class="flex justify-between"><dt>First hour, 7:30–17:30 weekdays</dt><dd class="font-display font-700 text-lg">{gbp(emergency.firstHour)}</dd></div><div class="flex justify-between"><dt>First hour, evenings / weekends / bank holidays</dt><dd class="font-display font-700 text-lg">{gbp(emergency.firstHourOOH)}</dd></div><div class="flex justify-between"><dt>Each further 30 minutes</dt><dd class="font-display font-700 text-lg">{gbp(emergency.perHalfHour)}</dd></div></dl><a href={`tel:${emergency.phoneHref}`} class="btn btn-red mt-5">☎ {emergency.phone}</a></div>
        <div class="bg-white border-2 border-graphite p-6"><h2 class="display-md">Quoted work</h2><ul class="mt-3 grid gap-2 text-graphite/85">{site.services.filter((s) => !/fixed/.test(s.price ?? '')).map((s) => <li class="flex justify-between gap-4 border-b border-graphite/15 py-2"><span>{s.name}</span><span class="font-display font-700 whitespace-nowrap">{s.price}</span></li>)}</ul><a href="/quote" class="btn btn-yellow mt-5">Get a quote ›</a></div>
        <dl class="dashed-box p-5">{pf.map((f) => <div class="mb-4 last:mb-0"><dt class="display-sm">{f.q}</dt><dd class="mt-1 text-sm text-graphite/80">{f.a}</dd></div>)}</dl>
      </div>
    </div>
  </section>
</Base>
