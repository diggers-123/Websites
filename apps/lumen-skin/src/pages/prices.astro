---
import Base from '@/layouts/Base.astro';
import { site, courses } from '@/site.config';
import { faqSchema } from '@site/core';
const faqs = site.faqs.filter((f) => /courses|cancellation|patch/.test(f.q));
---
<Base title="Prices & courses" description="Lumen Skin Studio prices: Signature facial £75, peels from £95, microneedling £180, LED £35, dermaplaning £60. Courses save 15–20% and can be split over three months." schema={[faqSchema(faqs)]}>
  <section class="light rounded-b-[40px]"><div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 pt-12 lg:pt-20 pb-14"><p class="eyebrow">Prices &amp; courses</p><h1 class="display-xl mt-3">Honest prices.</h1><p class="mt-4 text-plum/80 max-w-xl">Single treatments when you want one; courses when you want results. Courses are valid for 12 months and can be split over three months at no extra cost.</p></div></section>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 py-14 grid lg:grid-cols-2 gap-10 items-start">
    <div><h2 class="display-lg mb-6">Single treatments</h2><ul class="panel divide-y divide-lilac-2">{site.services.map((s) => <li class="p-5 flex items-center justify-between gap-4"><div><p class="display-sm">{s.name}</p><p class="text-xs text-mute mt-1">{s.durationMins} min</p></div><div class="flex items-center gap-4"><span class="font-display font-600 text-lg">{s.price}</span><a href={`/book?treatment=${s.slug}`} class="btn btn-plum !py-2 !px-4 !text-sm">Book</a></div></li>)}</ul></div>
    <div><h2 class="display-lg mb-6">Courses</h2><ul class="grid gap-4">{courses.map((c) => <li class="panel p-5 flex items-center justify-between gap-4 border-2 border-transparent hover:border-tang transition-colors"><div><p class="display-sm">{c.name}</p><p class="text-xs text-tang mt-1">Save £{c.saves / 100}</p></div><div class="text-right"><p class="font-display font-600 text-lg">£{c.price / 100}</p><p class="text-xs text-mute">or 3 × £{Math.round(c.price / 300)}</p></div></li>)}</ul><p class="mt-5 text-sm text-mute">Courses are booked after a consultation so we can grade them properly. <a class="underline" href="/consultation">Book one free</a>.</p></div>
  </section>
  <section class="bg-white rounded-[40px] mx-3 lg:mx-6 py-14"><div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 grid lg:grid-cols-[1fr_2fr] gap-10"><h2 class="display-lg">Small print</h2><dl class="divide-y divide-lilac-2">{faqs.map((f) => <div class="py-5"><dt class="display-sm">{f.q}</dt><dd class="mt-2 text-plum/80">{f.a}</dd></div>)}</dl></div></section>
</Base>
