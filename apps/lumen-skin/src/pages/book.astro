---
import Base from '@/layouts/Base.astro';
import TreatmentBooking from '@/components/booking/TreatmentBooking';
import { site } from '@/site.config';
const b = site.booking;
---
<Base title="Book a treatment" description="Book a facial, peel, microneedling, LED or dermaplaning at Lumen Skin Studio, Brighton. Tuesday to Saturday, late night Thursday." hideBookBar>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 pt-10 lg:pt-16 pb-20">
    <p class="eyebrow">Online booking</p>
    <h1 class="display-xl mt-2">Book a treatment</h1>
    <p class="mt-4 text-plum/80 max-w-xl">Not sure what to book? Start with the free <a class="underline" href="/consultation">skin consultation</a>.</p>
    <div class="mt-10">
      {b.provider === 'calcom' && (<div class="panel overflow-hidden min-h-[640px]"><div id="cal-inline" style="width:100%;height:100%;min-height:640px;overflow:auto"></div><script is:inline define:vars={{ link: b.calcomLink }}>(function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init"); Cal("init", { origin: "https://cal.com" }); Cal("inline", { elementOrSelector: "#cal-inline", calLink: link, layout: "month_view" });</script></div>)}
      {b.provider === 'calendly' && (<div class="panel overflow-hidden"><div class="calendly-inline-widget" data-url={b.calendlyUrl} style="min-width:320px;height:700px"></div><script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script></div>)}
      {(b.provider === 'demo' || b.provider === 'custom') && <TreatmentBooking client:load services={site.services} hours={site.hours} booking={b} phone={site.phone} policy={b.policy} />}
    </div>
    <div class="mt-14 grid md:grid-cols-3 gap-4">{[['Rather ring?', `${site.phone}, Tuesday to Saturday.`], ['Changes', site.booking.policy ?? ''], ['Before peels & needling', 'Patch test 48 hours before your first; no retinoids for 3 days before; SPF daily after.']].map(([t, b]) => <div class="panel p-5"><h2 class="display-sm">{t}</h2><p class="mt-2 text-sm text-plum/80">{b}</p></div>)}</div>
  </section>
</Base>
