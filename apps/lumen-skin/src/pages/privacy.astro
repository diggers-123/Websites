---
import Legal from '@/layouts/Legal.astro';
import { site } from '@/site.config';
---
<Legal title="Privacy notice" description={`How ${site.name} uses personal and health information from consultations, bookings and this website.`} reviewed={site.legal.policiesReviewed}>
  <h2>Who we are</h2><p>{site.legal.legalName}, {site.address.line1}, {site.address.line2}, {site.address.town} {site.address.postcode}. Contact <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  <h2>What we collect and why</h2><ul><li><strong>Bookings and enquiries:</strong> name, contact details, treatment and appointment details — to provide the service and send confirmations/reminders (contract).</li><li><strong>Consultation records:</strong> skin concerns, medical history, medication, pregnancy status, patch-test results and skin images (special category data). Processed with your explicit consent, which you can withdraw; needed to treat you safely. Retained for 7 years in line with insurer requirements.</li><li><strong>Results photographs:</strong> only published with separate written consent, which you can withdraw at any time.</li><li><strong>Website:</strong> no analytics or advertising cookies by default.</li></ul>
  <h2>Sharing</h2><p>Booking/form providers configured for this site act as processors. Health information is never shared without your consent except where legally required.</p>
  <h2>Your rights</h2><p>Access, correction, deletion, restriction, objection and withdrawal of consent: email <a href={`mailto:${site.email}`}>{site.email}</a>. Complaints: <a href="https://ico.org.uk" rel="noopener">ico.org.uk</a>.</p>
</Legal>
