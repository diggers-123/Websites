---
const crop = ['', '-scale-x-100', 'scale-110 object-[50%_0%]'];
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site, results } from '@/site.config';
import { img, treatmentImage } from '@/images';
const treatments = site.services.filter((s) => s.slug !== 'skin-consultation');
const steps = [['Scan', 'A skin-imaging scan shows what\'s happening under the surface: pigment, dehydration, congestion.'], ['Plan', 'We agree what matters to you and write a plan with honest prices and timescales. No obligation.'], ['Treat', 'Treatments graded to your skin. You feel the difference in one; you see it over a course.'], ['Keep', 'A monthly maintenance habit and three products you actually need. That\'s it.']];
---
<Base>
  <!-- HERO: one light -->
  <section class="light light-drift rounded-b-[40px] overflow-hidden">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 pt-14 lg:pt-24 pb-16 lg:pb-24 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
      <div>
        <p class="eyebrow">Skin studio · North Laine, Brighton</p>
        <h1 class="display-xl mt-4">Skin that looks like you slept.</h1>
        <p class="mt-6 max-w-md text-lg text-plum/80">Results-led facials, peels, microneedling and LED — graded to your skin, honest about what works. Start with a free consultation and a scan.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a href={site.primaryCta.href} class="btn btn-tang">{site.primaryCta.label}</a><a href={site.secondaryCta!.href} class="btn btn-white">{site.secondaryCta!.label}</a></div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-plum/70">{site.credentials?.slice(0, 3).map((c) => <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-tang"></span>{c.label}</li>)}</ul>
      </div>
      <div class="relative aspect-[4/5] max-w-[480px] w-full justify-self-center lg:justify-self-end rounded-[40px] overflow-hidden shadow-[0_40px_80px_-30px_rgba(59,28,79,0.45)]"><Image src={img('hero')} alt="Close-up of glowing skin in warm light" widths={[640, 1024, 1400]} sizes="(min-width:1024px) 40vw, 90vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" /></div>
    </div>
  </section>

  <!-- TREATMENT CAROUSEL -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10">
      <div class="flex items-end justify-between gap-6 mb-8"><div><p class="eyebrow">Treatments</p><h2 class="display-lg mt-2">Five things we do very well.</h2></div><a href="/treatments" class="hidden sm:inline-flex btn btn-outline">All treatments</a></div>
    </div>
    <div class="carousel px-5 sm:px-8 lg:px-10 lg:pl-[max(2.5rem,calc((100vw-1400px)/2+2.5rem))] scroll-pl-5 sm:scroll-pl-8 lg:scroll-pl-[max(2.5rem,calc((100vw-1400px)/2+2.5rem))]">
      {treatments.map((t, i) => <a href={`/treatments/${t.slug}`} class="group w-[clamp(220px,24vw,300px)]" data-reveal data-reveal-delay={i * 60}><div class="orb bg-white"><Image src={img(treatmentImage[t.slug])} alt={t.name} widths={[400, 640]} sizes="300px" class="absolute inset-0 w-full h-full object-cover" /></div><h3 class="display-sm mt-4 group-hover:text-tang transition-colors">{t.name}</h3><p class="text-sm text-plum/70 mt-1">{t.price} · {t.durationMins} min</p></a>)}
      <div class="w-6" aria-hidden="true"></div>
    </div>
  </section>

  <!-- RESULTS STORIES -->
  <section class="bg-white rounded-[40px] mx-3 lg:mx-6 py-16 lg:py-24">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10">
      <div class="flex items-end justify-between gap-6 mb-10"><div><p class="eyebrow">Results</p><h2 class="display-lg mt-2">Stories, not stock photos.</h2></div><p class="text-sm text-mute hidden sm:block">Fictional results for demonstration</p></div>
      <div class="grid md:grid-cols-3 gap-6">{results.map((r, i) => <article class="tilt rounded-[28px] overflow-hidden bg-lilac" data-reveal data-reveal-delay={i * 80}><div class="grid grid-cols-2"><div class="relative aspect-[4/5] overflow-hidden"><Image src={img(r.before)} alt="Before" widths={[400, 640]} sizes="25vw" class={`absolute inset-0 w-full h-full object-cover ${crop[i % crop.length]}`} /><span class="absolute top-3 left-3 eyebrow bg-white/90 rounded-full px-2 py-1 !text-plum">Before</span></div><div class="relative aspect-[4/5] overflow-hidden"><Image src={img(r.after)} alt="After" widths={[400, 640]} sizes="25vw" class={`absolute inset-0 w-full h-full object-cover ${crop[i % crop.length]}`} /><span class="absolute top-3 right-3 eyebrow bg-tang text-white rounded-full px-2 py-1 !text-white">After · {r.months} mo</span></div></div><div class="p-5"><h3 class="display-sm">{r.title}</h3><p class="text-sm text-plum/75 mt-2">{r.plan}</p><p class="mt-3 font-display italic">“{r.quote}”</p></div></article>)}</div>
      <a href="/results" class="btn btn-plum mt-10">More results</a>
    </div>
  </section>

  <!-- FIRST VISIT -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 grid lg:grid-cols-[1fr_1.4fr] gap-10 items-center">
      <div><p class="eyebrow">Your first visit</p><h2 class="display-lg mt-2">Scan, plan, treat, keep.</h2><p class="mt-4 text-plum/80 max-w-sm">Everything starts with a free consultation. Thirty minutes, a skin scan, and a written plan — even if you never book anything else.</p><a href="/consultation" class="btn btn-tang mt-6">Book a free consultation</a></div>
      <ol class="grid sm:grid-cols-2 gap-4">{steps.map(([t, b], i) => <li class="panel p-6" data-reveal data-reveal-delay={i * 80}><span class="size-10 rounded-full bg-[radial-gradient(circle,#ff7a1a,#ff9ecf)] text-white font-display font-600 grid place-items-center">{i + 1}</span><h3 class="display-sm mt-4">{t}</h3><p class="text-sm text-plum/75 mt-2">{b}</p></li>)}</ol>
    </div>
  </section>

  <!-- STUDIO + reviews -->
  <section class="light-plum text-white rounded-[40px] mx-3 lg:mx-6 py-16 lg:py-24">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 grid lg:grid-cols-2 gap-10 items-center">
      <div class="relative aspect-[4/3] rounded-[28px] overflow-hidden"><Image src={img('room')} alt="The treatment room: lilac walls, warm light, a treatment bed" widths={[640, 1024, 1400]} sizes="(min-width:1024px) 50vw, 100vw" class="absolute inset-0 w-full h-full object-cover" /></div>
      <div><div class="flex items-baseline justify-between gap-4"><p class="eyebrow !text-pink">Kind words</p><span class="text-xs text-white/60">Fictional reviews for demonstration</span></div><div class="mt-5 grid gap-6">{site.testimonials.slice(0, 3).map((t) => <figure><blockquote class="font-display text-xl leading-snug">“{t.quote}”</blockquote><figcaption class="text-sm text-white/70 mt-2">{t.name} · {t.context}</figcaption></figure>)}</div><a href="/about" class="btn btn-white mt-8">The studio &amp; Amara</a></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-28"><div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10 text-center"><h2 class="display-xl">Ready when you are.</h2><p class="mt-4 text-plum/80 max-w-md mx-auto">Book a treatment, or let's look at your skin first — the consultation is free.</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/book" class="btn btn-tang">Book a treatment</a><a href="/consultation" class="btn btn-plum">Free consultation</a></div></div></section>
</Base>
