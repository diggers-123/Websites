---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { faqSchema } from '@site/core';
const cats = [...new Set(site.services.map((s) => s.category))];
const faqs = site.faqs.filter((f) => /unedited|travel|get the photos/.test(f.q));
---
<Base title="Pricing" description="Wedding photography from £650 (elopement) to £2,400 (full day); family sessions £320; newborn £380; portraits £260. Everything included listed plainly." schema={[faqSchema(faqs)]}>
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 pt-10 lg:pt-20 pb-16 grid lg:grid-cols-[3fr_2fr] gap-10 items-end">
    <h1 class="serif-xl">Pricing<span class="text-verm">,</span> <em>plainly</em></h1>
    <p class="text-ink-2 text-lg leading-relaxed max-w-md">No packages named after precious metals. Each option says what it includes. Travel across Scotland is included within 60 miles of Edinburgh; beyond that, mileage at cost.</p>
  </section>
  {cats.map((c) => (
    <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 py-12 border-t hairline grid lg:grid-cols-[1fr_3fr] gap-10">
      <h2 class="serif-lg">{c}</h2>
      <div class="grid md:grid-cols-3 gap-8">{site.services.filter((s) => s.category === c).map((s) => <div><p class="caption">{s.name}</p><p class="serif-md mt-2">{s.price}</p><p class="text-sm text-ink-2 mt-3">{s.summary}</p><ul class="mt-4 text-sm grid gap-1 border-t hairline pt-3">{s.includes?.map((x) => <li class="flex gap-2"><span class="text-verm">—</span>{x}</li>)}</ul></div>)}</div>
    </section>
  ))}
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 py-16 border-t hairline grid lg:grid-cols-[1fr_3fr] gap-10">
    <h2 class="serif-lg">Extras<span class="text-verm">.</span></h2>
    <dl class="grid md:grid-cols-3 gap-8 text-sm">{[['Second photographer', '£450 — for big weddings or two locations'], ['Linen album', 'From £390 — 30 pages, designed with you'], ['Fine art prints', 'From £45 — archival paper, any size'], ['Extra hour', '£220 — decided on the day if the party is good'], ['Pre-wedding session', '£260 — an hour, somewhere you like'], ['Deposit', `£500 secures a wedding date; balance a month before`]].map(([t, d]) => <div class="border-t hairline pt-4"><dt class="font-medium">{t}</dt><dd class="text-ink-2 mt-1">{d}</dd></div>)}</dl>
  </section>
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 py-16 border-t hairline grid lg:grid-cols-[1fr_3fr] gap-10 pb-24">
    <h2 class="serif-lg">Honest answers<span class="text-verm">.</span></h2>
    <dl>{faqs.map((f) => <div class="py-5 border-b hairline grid md:grid-cols-[1fr_2fr] gap-3"><dt class="serif-sm">{f.q}</dt><dd class="text-ink-2">{f.a}</dd></div>)}</dl>
  </section>
</Base>
