---
import Base from '@/layouts/Base.astro';
import Frames from '@/components/Frames.astro';
import { site } from '@/site.config';
import { familyFrames } from '@/content';
const f = site.services.filter((s) => s.category !== 'Weddings');
---
<Base title="Family, newborn & portrait photography" description="Documentary family photography in Edinburgh: 90-minute family sessions £320, newborn at home £380, portraits £260. No posing, bring snacks.">
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 pt-10 lg:pt-20 pb-16 grid lg:grid-cols-[3fr_2fr] gap-10 items-end">
    <h1 class="serif-xl">Families<span class="text-verm">,</span> <em>unposed</em></h1>
    <p class="text-ink-2 text-lg leading-relaxed max-w-md">Ninety minutes at home, on the beach, in the park. Nobody says cheese. The kids do what they do, and you get photographs of them actually being them — which, in five years, is the only thing you'll want.</p>
  </section>
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 pb-24"><Frames frames={familyFrames} /></section>
  <section class="border-y hairline"><div class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 py-20 grid lg:grid-cols-[1fr_2fr] gap-10">
    <h2 class="serif-lg">Sessions<span class="text-verm">.</span></h2>
    <div class="grid sm:grid-cols-3 gap-8">{f.map((s) => <div class="border-t hairline pt-5"><p class="caption">{s.category} · {s.name}</p><p class="serif-md mt-2">{s.price}</p><p class="text-sm text-ink-2 mt-3">{s.summary}</p><ul class="mt-4 text-sm grid gap-1">{s.includes?.map((x) => <li class="flex gap-2"><span class="text-verm">—</span>{x}</li>)}</ul><a href={`/check-your-date?type=${encodeURIComponent(s.name)}`} class="btn mt-5">Book a {s.name.toLowerCase()}</a></div>)}</div>
  </div></section>
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 py-20 grid md:grid-cols-3 gap-10">
    {[['Where', 'Your home (honestly the best), Portobello beach, the Meadows, Holyrood, or anywhere you love within an hour of Edinburgh.'], ['When', 'The hour after breakfast or the hour before bed. Never midday. Weekends and weekdays.'], ['What to wear', 'What you wear. Not matching, not white, not new. Clothes you can run in.']].map(([t, d]) => <div class="border-t hairline pt-5"><h2 class="serif-sm">{t}</h2><p class="mt-3 text-ink-2">{d}</p></div>)}
  </section>
</Base>
