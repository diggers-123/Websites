---
import Base from '@/layouts/Base.astro';
import DateCheck from '@/components/DateCheck.astro';
import { site } from '@/site.config';
import { hoursLines } from '@site/core';
const lines = hoursLines(site);
---
<Base title="Contact" description={`Contact Nell Ashworth Photography, Edinburgh: ${site.email}, ${site.phone}. Studio in Leith by appointment.`}>
  <section class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 pt-10 lg:pt-20 pb-24 grid lg:grid-cols-[2fr_3fr] gap-12 lg:gap-20">
    <div>
      <h1 class="serif-xl !text-[clamp(2.6rem,7vw,7rem)]">Say hello<span class="text-verm">.</span></h1>
      <dl class="mt-10 grid gap-6">
        <div><dt class="caption">Email</dt><dd class="serif-sm mt-1 break-all"><a href={`mailto:${site.email}`} class="hover:text-verm">{site.email}</a></dd></div>
        <div><dt class="caption">Phone (office hours)</dt><dd class="serif-sm mt-1"><a href={`tel:${site.phoneHref}`} class="hover:text-verm">{site.phone}</a></dd></div>
        <div><dt class="caption">Studio, by appointment</dt><dd class="text-ink-2 mt-1 not-italic">{site.address.line1}, {site.address.line2}, {site.address.town} {site.address.postcode}</dd></div>
        <div><dt class="caption">Office hours</dt><dd class="text-sm text-ink-2 mt-1">{lines.map((l) => <span class="block">{l.days}: {l.time}</span>)}</dd></div>
      </dl>
      <p class="mt-8 caption">Weddings and sessions happen on weekends; replies may take until Monday.</p>
    </div>
    <div><p class="caption mb-6">The quickest way: check your date and tell me about it</p><DateCheck /></div>
  </section>
</Base>
