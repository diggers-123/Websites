---
import { site } from '@/site.config';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="relative z-50 bg-paper">
  <div class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12 h-[72px] lg:h-[88px] flex items-center justify-between gap-6">
    <a href="/" class="font-sans tracking-[0.18em] uppercase text-[0.8rem] font-medium stop" aria-label={`${site.name} — home`}>Nell Ashworth</a>
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-8">
      {site.nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={['text-[0.8rem] tracking-[0.14em] uppercase hover:text-verm transition-colors', isActive(n.href) && 'text-verm']}>{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.primaryCta.href} class="btn hidden sm:inline-flex">{site.primaryCta.label}</a>
      <button type="button" class="lg:hidden text-[0.8rem] tracking-[0.14em] uppercase py-3" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">Menu</button>
    </div>
  </div>
  <div id="mobile-nav" data-nav-panel class="lg:hidden absolute inset-x-0 top-full h-[calc(100dvh-100%)] bg-ink text-paper overflow-y-auto" hidden>
    <nav aria-label="Mobile" class="px-6 py-10 flex flex-col">
      {site.nav.map((n, i) => <a href={n.href} class="serif-md py-3 border-b hairline flex items-baseline gap-4" aria-current={isActive(n.href) ? 'page' : undefined}><span class="frame-no text-grey">0{i + 1}</span>{n.label}</a>)}
      <a href={site.primaryCta.href} class="serif-md py-3 text-verm">{site.primaryCta.label} →</a>
      <a href="/contact" class="text-[0.8rem] tracking-[0.14em] uppercase mt-8 text-paper/70">Contact</a>
    </nav>
  </div>
</header>
