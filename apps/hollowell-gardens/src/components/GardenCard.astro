---
import { Image } from 'astro:assets';
import type { Garden } from '@/content';
import { img } from '@/images';
interface Props { garden: Garden; sizes?: string; aspect?: string; index?: number; eager?: boolean }
const { garden, sizes = '(min-width:1024px) 40vw, 100vw', aspect = 'aspect-[4/5]', index = 0, eager = false } = Astro.props;
---
<a href={`/gardens/${garden.slug}`} class="group block" data-reveal data-reveal-delay={index * 70}>
  <div class={`relative overflow-hidden rounded-sm ${aspect}`}>
    <Image src={img(garden.cover)} alt={garden.coverAlt} widths={[480, 800, 1200, 1600]} {sizes} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-4 border-t hairline pt-3">
    <div>
      <p class="smallcaps opacity-60">{garden.place} · {garden.year}</p>
      <h3 class="serif-sm mt-1 group-hover:text-terra transition-colors">{garden.title}</h3>
    </div>
    <span class="font-serif italic text-lg opacity-70 shrink-0">{garden.type}</span>
  </div>
</a>
