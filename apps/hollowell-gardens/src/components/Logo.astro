---
/** Wordmark + seed-head mark. */
interface Props { class?: string; stacked?: boolean }
const { class: cls = '', stacked = false } = Astro.props;
---
<span class={`inline-flex items-center gap-3 ${cls}`}>
  <svg class="h-[2em] w-auto shrink-0" viewBox="0 0 40 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
    <path d="M20 46 C20 34 20 26 20 18"/>
    <circle cx="20" cy="12" r="6"/>
    <path d="M20 6 l0 -4 M26 12 l4 0 M14 12 l-4 0 M24.2 7.8 l2.8 -2.8 M15.8 7.8 l-2.8 -2.8 M24.2 16.2 l2.8 2.8 M15.8 16.2 l-2.8 2.8"/>
    <path d="M20 30 c-5 -1 -9 -5 -10 -10 c5 1 9 5 10 10z M20 36 c5 -1 9 -5 10 -10 c-5 1 -9 5 -10 10z"/>
  </svg>
  <span class:list={['font-serif leading-none', stacked ? 'flex flex-col' : '']}>
    <span class="text-[1.35em] tracking-tight">Hollowell</span>
    {stacked && <span class="smallcaps mt-1 opacity-80">Garden design</span>}
  </span>
</span>
