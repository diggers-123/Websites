---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Botanical from '@/components/Botanical.astro';
import { site } from '@/site.config';
import { img } from '@/images';
import { faqSchema } from '@site/core';
const faqs = site.faqs.slice(0, 4);
---
<Base title="Services" description="Garden design, planting design, managed landscaping and garden consultations in Stroud and across the Cotswolds. Fixed fees, quoted up front." schema={[faqSchema(faqs)]}>
  <section class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 pt-14 lg:pt-24 pb-16 grid lg:grid-cols-[3fr_2fr] gap-10 items-end">
    <div>
      <p class="smallcaps text-terra">Services &amp; fees</p>
      <h1 class="serif-xl mt-3">What I do, and what it costs.</h1>
    </div>
    <p class="lede text-ink/80">Every project is quoted as a fixed fee after a consultation. The prices below are honest starting points, not teasers.</p>
  </section>

  <section class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 pb-24 grid gap-20">
    {site.services.map((s, i) => (
      <article class:list={['grid lg:grid-cols-12 gap-8 lg:gap-12 items-center', i % 2 === 1 && 'lg:[&>*:first-child]:order-2']} data-reveal>
        <div class:list={['lg:col-span-6 relative overflow-hidden rounded-sm', i % 2 === 0 ? 'aspect-[4/5]' : 'aspect-[3/2]']}>
          {s.image && <Image src={img(s.image.src)} alt={s.image.alt} widths={[640, 1024, 1400]} sizes="(min-width:1024px) 50vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />}
        </div>
        <div class:list={['lg:col-span-5', i % 2 === 0 ? 'lg:col-start-8' : 'lg:col-start-1']}>
          <p class="smallcaps opacity-60">0{i + 1}</p>
          <h2 class="serif-lg mt-2"><a href={`/services/${s.slug}`} class="hover:text-terra">{s.name}</a></h2>
          <p class="font-serif italic text-xl mt-3 text-terra">{s.price}</p>
          <p class="mt-5 text-ink/80 leading-relaxed">{s.summary}</p>
          <ul class="mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
            {s.includes?.map((inc) => <li class="flex gap-2"><span class="text-terra">—</span>{inc}</li>)}
          </ul>
          <a href={`/services/${s.slug}`} class="arrow-link mt-7 hover:text-terra">About {s.name.toLowerCase()}</a>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-moss text-linen on-moss py-20 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-[22vw] max-w-[260px] text-sage/40 pointer-events-none" aria-hidden="true"><Botanical kind="fern" /></div>
    <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 grid lg:grid-cols-[1fr_2fr] gap-10 relative">
      <h2 class="serif-lg">Questions people ask first</h2>
      <dl class="border-t hairline-light">
        {faqs.map((f) => (
          <div class="border-b hairline-light py-6 grid md:grid-cols-[1fr_2fr] gap-3">
            <dt class="serif-sm">{f.q}</dt>
            <dd class="opacity-85 leading-relaxed">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
