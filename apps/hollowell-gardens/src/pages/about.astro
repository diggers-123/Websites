---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Botanical from '@/components/Botanical.astro';
import Testimonials from '@/components/Testimonials.astro';
import { site } from '@/site.config';
import { img } from '@/images';
const anna = site.team![0];
---
<Base title="About" description="Anna Hollowell is a garden designer based in Stroud, Gloucestershire. Horticulturist first, designer second — fourteen years of Cotswold gardens.">
  <section class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 pt-14 lg:pt-24 pb-16 grid lg:grid-cols-12 gap-8 lg:gap-12">
    <div class="lg:col-span-5 relative aspect-[4/5] overflow-hidden rounded-sm order-2 lg:order-1">
      <Image src={img(anna.image!.src)} alt={anna.image!.alt} widths={[640, 1024, 1400]} sizes="(min-width:1024px) 42vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
    </div>
    <div class="lg:col-span-6 lg:col-start-7 order-1 lg:order-2 flex flex-col justify-center">
      <p class="smallcaps text-terra">About</p>
      <h1 class="serif-xl mt-3">Plants first. <em>Then</em> the drawing.</h1>
      <p class="lede mt-6 text-ink/85">{anna.bio}</p>
      <div class="mt-8 flex flex-col gap-5 text-[1.05rem] leading-relaxed text-ink/85 measure">
        <p>I came to design through horticulture — three years at a specialist perennial nursery and a diploma in planting design before I ever drew a plan. It means I design from the soil up: what will actually grow here, how it will look in February, how much work it will be in ten years.</p>
        <p>The studio is a converted dairy outside Stroud. Most of my work is within thirty miles — the Cotswold escarpment, the Severn Vale, Bath and the edges of Wiltshire — because gardens need visiting, often, and I would rather do fewer well.</p>
        <p>I work alone on the design side and with two landscape contractors I trust completely on the build side. You will deal with me throughout.</p>
      </div>
    </div>
  </section>

  <section class="bg-linen-2 py-16">
    <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 grid sm:grid-cols-3 gap-8">
      {site.credentials?.map((c) => (
        <div class="border-t hairline pt-4">
          <p class="serif-md">{c.label}</p>
          <p class="smallcaps opacity-60 mt-2">{c.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute right-0 top-10 w-[20vw] max-w-[240px] text-moss/40 pointer-events-none" aria-hidden="true"><Botanical kind="allium" /></div>
    <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 grid lg:grid-cols-[1fr_2fr] gap-10 lg:gap-20 relative">
      <h2 class="serif-lg">How I work</h2>
      <ol class="grid sm:grid-cols-2 gap-x-10 gap-y-10">
        {[
          ['Honest about money', 'Fees and build budgets discussed at the first meeting, in writing after it.'],
          ['Designed for year ten', 'Trees and structure planned for how they will look mature, not on handover day.'],
          ['Local materials', 'Cotswold stone, oak, clay — from quarries and sawmills within the county where possible.'],
          ['Wildlife by default', 'Water, long-season nectar and untidy corners in every scheme unless you ask otherwise.'],
        ].map(([t, d], i) => (
          <li class="border-t hairline pt-5"><span class="smallcaps opacity-60">0{i + 1}</span><h3 class="serif-md mt-2">{t}</h3><p class="mt-3 text-ink/80">{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials tone="moss" limit={3} />
</Base>
