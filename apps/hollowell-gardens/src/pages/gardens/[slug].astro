---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import GardenCard from '@/components/GardenCard.astro';
import { gardens } from '@/content';
import { img } from '@/images';
import { site } from '@/site.config';
import { breadcrumbSchema } from '@site/core';

export function getStaticPaths() {
  return gardens.map((g) => ({ params: { slug: g.slug }, props: { garden: g } }));
}
const { garden } = Astro.props;
const idx = gardens.findIndex((g) => g.slug === garden.slug);
const next = gardens[(idx + 1) % gardens.length];
const schema = [breadcrumbSchema([
  { name: 'Home', url: site.seo.siteUrl },
  { name: 'Gardens', url: `${site.seo.siteUrl}/gardens` },
  { name: garden.title, url: `${site.seo.siteUrl}/gardens/${garden.slug}` },
])];
---
<Base title={`${garden.title} — ${garden.place}`} description={`${garden.type} garden in ${garden.place} (${garden.year}): ${garden.brief} Designed and built by Hollowell Garden Design.`} {schema}>
  <article>
    <header class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 pt-14 lg:pt-24 pb-10 grid lg:grid-cols-[2fr_1fr] gap-8 items-end">
      <div>
        <p class="smallcaps text-terra"><a href="/gardens" class="hover:underline">Gardens</a> · {garden.type}</p>
        <h1 class="serif-xl mt-3">{garden.title}</h1>
      </div>
      <dl class="grid grid-cols-3 gap-4 border-t hairline pt-4 text-sm">
        <div><dt class="smallcaps opacity-60">Place</dt><dd class="font-serif text-xl">{garden.place}</dd></div>
        <div><dt class="smallcaps opacity-60">Year</dt><dd class="font-serif text-xl">{garden.year}</dd></div>
        <div><dt class="smallcaps opacity-60">Size</dt><dd class="font-serif text-xl">{garden.size}</dd></div>
      </dl>
    </header>

    <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12">
      {garden.before && garden.after ? (
        <div>
          <BeforeAfter before={garden.before} after={garden.after} />
          <p class="mt-3 smallcaps opacity-60">Drag to compare before and after</p>
        </div>
      ) : (
        <div class="relative aspect-[16/9] overflow-hidden rounded-sm">
          <Image src={img(garden.cover)} alt={garden.coverAlt} widths={[768, 1200, 1600, 2048]} sizes="(min-width:1500px) 1400px, 94vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>

    <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 py-16 lg:py-24 grid lg:grid-cols-[1fr_2fr_1fr] gap-10 lg:gap-16">
      <aside class="order-2 lg:order-1 lg:sticky lg:top-8 self-start">
        <p class="smallcaps opacity-60">The brief</p>
        <p class="font-serif text-xl mt-2 leading-snug">{garden.brief}</p>
        <p class="smallcaps opacity-60 mt-8">Services</p>
        <ul class="mt-2 flex flex-col gap-1">{garden.services.map((s) => <li>{s}</li>)}</ul>
        <p class="smallcaps opacity-60 mt-8">Budget band</p>
        <p class="font-serif text-xl mt-2">{garden.budgetBand}</p>
      </aside>
      <div class="order-1 lg:order-2">
        {garden.story.map((p, i) => <p class:list={['leading-relaxed text-ink/85 mb-6', i === 0 ? 'lede' : 'text-[1.05rem]']}>{p}</p>)}
      </div>
      <aside class="order-3">
        <p class="smallcaps opacity-60">Key plants</p>
        <ul class="mt-3 flex flex-col">{garden.plants.map((p) => <li class="font-serif italic border-b hairline py-2">{p}</li>)}</ul>
      </aside>
    </div>

    {garden.gallery.length > 1 && (
      <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 pb-16 lg:pb-24 ed-grid">
        {garden.gallery.slice(1).map((g, i) => (
          <figure class:list={['col-span-12', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5 md:pt-16']} data-reveal>
            <div class="relative aspect-[4/5] overflow-hidden rounded-sm"><Image src={img(g.key)} alt={g.alt} widths={[640, 1024, 1400]} sizes="(min-width:768px) 50vw, 100vw" class="absolute inset-0 w-full h-full object-cover" /></div>
            <figcaption class="mt-3 text-sm font-serif italic opacity-70">{g.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="bg-linen-2 py-16">
      <div class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 grid lg:grid-cols-[1fr_1fr] gap-10 items-end">
        <div>
          <p class="smallcaps opacity-60">Next garden</p>
          <div class="mt-4 max-w-md"><GardenCard garden={next} aspect="aspect-[3/2]" sizes="(min-width:1024px) 40vw, 100vw" /></div>
        </div>
        <div class="lg:text-right">
          <p class="serif-md">Something similar in mind?</p>
          <a href="/contact" class="btn btn-terra mt-5">Book a consultation</a>
        </div>
      </div>
    </div>
  </article>
</Base>
