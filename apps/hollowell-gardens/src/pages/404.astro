---
import Base from '@/layouts/Base.astro';
import Botanical from '@/components/Botanical.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="mx-auto max-w-[1500px] px-5 sm:px-8 lg:px-12 py-24 min-h-[60vh] grid lg:grid-cols-[2fr_1fr] gap-10 items-center">
    <div>
      <p class="smallcaps text-terra">404</p>
      <h1 class="serif-xl mt-3">Gone to seed.</h1>
      <p class="lede mt-5 text-ink/80 max-w-md">That page doesn't exist. Try the gardens, or start at the beginning.</p>
      <div class="mt-8 flex gap-3 flex-wrap"><a href="/" class="btn btn-moss">Home</a><a href="/gardens" class="btn btn-outline">Gardens</a></div>
    </div>
    <div class="w-48 lg:w-full max-w-[280px] text-moss/60 justify-self-center" aria-hidden="true"><Botanical kind="seedhead" /></div>
  </section>
</Base>
