---
import Base from '@/layouts/Base.astro';
---
<Base title="Image credits" description="Image sources for this demonstration website." noindex>
  <section class="mx-auto max-w-3xl px-5 sm:px-8 pt-16 lg:pt-24 pb-24">
    <h1 class="serif-xl">Image credits</h1>
    <p class="lede mt-6 text-ink/80">Photography on this demonstration site was generated for the project (AI-assisted) and depicts no real gardens, people or premises. Replace with the business's own photography before launch — see the README.</p>
    <p class="mt-4 text-ink/70">Botanical line drawings are original SVG artwork. Typefaces: Fraunces and Figtree, served locally under the SIL Open Font License.</p>
  </section>
</Base>
