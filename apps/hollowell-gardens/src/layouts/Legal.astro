---
import Base from './Base.astro';
interface Props { title: string; description: string; reviewed: string }
const { title, description, reviewed } = Astro.props;
---
<Base {title} {description}>
  <section class="bg-linen">
    <div class="mx-auto max-w-3xl px-5 sm:px-8 pt-16 lg:pt-24 pb-24">
      <h1 class="serif-xl">{title}</h1>
      <p class="smallcaps opacity-60 mt-4">Last reviewed {reviewed}</p>
      <div class="mt-8 p-4 border border-terra text-terra-2 text-sm rounded-sm">
        <strong>Template notice.</strong> This document is a starting point based on ICO guidance. It must be reviewed and adapted for the actual business before going live. It is not legal advice.
      </div>
      <div class="prose-legal mt-10"><slot /></div>
    </div>
  </section>
</Base>
<style is:global>
  .prose-legal h2 { font-family: var(--font-serif); font-size: 1.7rem; margin: 2.2rem 0 0.8rem; }
  .prose-legal p, .prose-legal li { font-size: 1.05rem; line-height: 1.65; margin: 0.6rem 0; color: color-mix(in srgb, var(--color-ink) 85%, transparent); }
  .prose-legal ul { padding-left: 1.3rem; list-style: disc; }
  .prose-legal a { text-decoration: underline; }
</style>
