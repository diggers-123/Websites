---
import '@/styles/theme.css';
import Head from '@site/core/components/Head.astro';
import DemoBanner from '@site/core/components/DemoBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBookBar from '@/components/MobileBookBar.astro';
import { site } from '@/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: unknown[];
  noindex?: boolean;
  /** Hide the sticky mobile booking bar (e.g. on the Book page itself). */
  hideBookBar?: boolean;
}
const { title, description, image, schema, noindex, hideBookBar = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <Head {site} {title} {description} {image} {schema} {noindex} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <DemoBanner {site} />
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideBookBar && <MobileBookBar />}
    <script>
      import { initReveal, initMobileNav } from '@site/core/components/reveal';
      initReveal();
      initMobileNav({ button: '[data-nav-toggle]', panel: '[data-nav-panel]' });
    </script>
  </body>
</html>
