---
import { site } from '@/site.config';
import { openStatus } from '@site/core';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const status = openStatus(site);
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="sticky top-0 z-50 bg-ink border-b-[3px] border-chalk relative">
  <div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8 flex items-center justify-between h-[68px] lg:h-[76px]">
    <a href="/" class="text-chalk hover:text-volt transition-colors" aria-label={`${site.name} — home`}>
      <Logo class="text-[1.15rem] lg:text-[1.35rem]" />
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-5 xl:gap-7">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'font-sans font-semibold text-[0.85rem] xl:text-[0.95rem] uppercase tracking-wide text-chalk relative py-2 whitespace-nowrap',
            'after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-[3px] after:bg-volt after:origin-left after:scale-x-0 after:transition-transform hover:after:scale-x-100',
            isActive(item.href) && 'after:scale-x-100',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden 2xl:inline-flex items-center gap-2 mono-label text-smoke whitespace-nowrap" aria-live="off">
        <span class:list={['inline-block size-2', status.open ? 'bg-volt' : 'bg-smoke']} aria-hidden="true"></span>
        {status.label}
      </span>
      <a href={`tel:${site.phoneHref}`} class="hidden md:max-lg:inline-flex xl:inline-flex mono-label text-chalk hover:text-volt px-2 py-3 whitespace-nowrap">{site.phone}</a>
      <a href={site.primaryCta.href} class="btn btn-volt hidden sm:inline-flex !py-2.5 !px-5 !text-base whitespace-nowrap">{site.primaryCta.label}</a>
      <button
        type="button"
        class="lg:hidden inline-flex flex-col justify-center items-center size-11 border-[3px] border-chalk text-chalk gap-[5px]"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="block w-5 h-[3px] bg-current"></span>
        <span class="block w-5 h-[3px] bg-current"></span>
        <span class="block w-5 h-[3px] bg-current"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" data-nav-panel class="lg:hidden absolute inset-x-0 top-full h-[calc(100dvh-100%)] bg-ink overflow-y-auto" hidden>
    <nav aria-label="Mobile" class="flex flex-col">
      {site.nav.map((item, i) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
           class="display-md px-6 py-4 border-b-[3px] border-ink-3 text-chalk hover:bg-volt hover:text-ink flex items-baseline gap-4">
          <span class="font-mono text-sm text-smoke">0{i + 1}</span>{item.label}
        </a>
      ))}
      <a href={site.primaryCta.href} class="display-md px-6 py-5 bg-volt text-ink">{site.primaryCta.label} →</a>
      <div class="px-6 py-6 mono-label text-smoke flex flex-col gap-2">
        <a href={`tel:${site.phoneHref}`} class="text-chalk">{site.phone}</a>
        <span>{site.address.line1}, {site.address.town} {site.address.postcode}</span>
        <span>{status.label}</span>
      </div>
    </nav>
  </div>
</header>
