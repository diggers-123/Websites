---
import { site } from '@/site.config';
---
<div class="sm:hidden fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto] border-t-[3px] border-chalk bg-ink">
  <a href={site.primaryCta.href} class="btn btn-volt !border-0 !py-4">{site.primaryCta.label} →</a>
  <a href={`tel:${site.phoneHref}`} class="flex items-center justify-center px-5 border-l-[3px] border-chalk text-chalk" aria-label={`Call ${site.phone}`}>
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
  </a>
</div>
<div class="sm:hidden h-[70px]" aria-hidden="true"></div>
