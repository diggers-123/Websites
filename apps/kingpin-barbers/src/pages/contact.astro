---
import Base from '@/layouts/Base.astro';
import HoursBoard from '@/components/HoursBoard.astro';
import { site } from '@/site.config';
const mapsQuery = encodeURIComponent(`${site.name}, ${site.address.line1}, ${site.address.town} ${site.address.postcode}`);
---
<Base title="Contact" description={`Find Kingpin Barber Co. at ${site.address.line1}, Leeds ${site.address.postcode}. Call ${site.phone}, email us, or send a message. Opening hours and directions.`}>
  <section class="bg-ink text-chalk">
    <div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-16 grid lg:grid-cols-2 gap-12">
      <div>
        <p class="mono-label text-volt mb-3">Contact</p>
        <h1 class="display-xl">Get in touch</h1>
        <p class="mt-6 text-xl text-chalk/80 max-w-md">Bookings are quickest online. For everything else — questions, lost property, wanting to work here — use whichever of these you like.</p>

        <dl class="mt-10 grid gap-6 font-mono">
          <div><dt class="mono-label text-smoke">Phone</dt><dd class="text-2xl"><a class="hover:text-volt" href={`tel:${site.phoneHref}`}>{site.phone}</a></dd></div>
          <div><dt class="mono-label text-smoke">Email</dt><dd class="text-xl break-all"><a class="hover:text-volt" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt class="mono-label text-smoke">Address</dt><dd class="text-xl not-italic">{site.address.line1}<br />{site.address.town} {site.address.postcode}</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.primaryCta.href} class="btn btn-volt">{site.primaryCta.label}</a>
          <a href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener" class="btn btn-ghost">Directions ↗</a>
        </div>
        <p class="mt-6 text-sm text-smoke">Nearest parking: Markets multi-storey (LS2 7HY), three minutes on foot. Leeds station is a ten-minute walk.</p>
      </div>

      <form class="border-[3px] border-chalk p-6 sm:p-8 grid gap-5 bg-ink-2" data-contact-form name="contact" method="post" novalidate>
        <h2 class="display-md">Send a message</h2>
        <div>
          <label class="label" for="c-name">Name</label>
          <input class="field" id="c-name" name="name" autocomplete="name" required />
          <span data-error-for="name" hidden></span>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="label" for="c-email">Email</label>
            <input class="field" id="c-email" name="email" type="email" autocomplete="email" required />
            <span data-error-for="email" hidden></span>
          </div>
          <div>
            <label class="label" for="c-phone">Phone <span class="font-normal text-smoke">(optional)</span></label>
            <input class="field" id="c-phone" name="phone" type="tel" autocomplete="tel" />
            <span data-error-for="phone" hidden></span>
          </div>
        </div>
        <div>
          <label class="label" for="c-msg">Message</label>
          <textarea class="field" id="c-msg" name="message" rows="5" required></textarea>
          <span data-error-for="message" hidden></span>
        </div>
        <p class="hidden" aria-hidden="true"><label>Leave empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
        <p class="text-xs text-smoke">We only use your details to reply. See our <a class="underline" href="/privacy">privacy notice</a>.</p>
        <div class="flex items-center gap-4 flex-wrap">
          <button type="submit" class="btn btn-volt">Send message</button>
          <p data-form-status role="status" aria-live="polite" class="text-sm"></p>
        </div>
      </form>
    </div>

    <div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8 pb-20 grid lg:grid-cols-2 gap-8">
      <HoursBoard />
      <div class="border-[3px] border-chalk min-h-[320px] bg-ink-2 relative">
        {site.address.mapEmbedUrl ? (
          <iframe src={site.address.mapEmbedUrl} title={`Map showing ${site.name}`} class="absolute inset-0 w-full h-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        ) : (
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 gap-4">
            <p class="display-md">Call Lane, LS1</p>
            <p class="text-chalk/70 max-w-xs">Between the Corn Exchange and the river. Look for the barber pole.</p>
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener" class="btn btn-ghost !text-base">Open in Google Maps ↗</a>
            <p class="text-xs text-smoke">Add <code>address.mapEmbedUrl</code> in site.config.ts to show an embedded map here.</p>
          </div>
        )}
      </div>
    </div>
  </section>
  <script>
    import { enhanceForm } from '@site/core';
    import { site } from '@/site.config';
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (form) {
      enhanceForm(form, {
        config: site.forms,
        formName: 'contact',
        rules: {
          name: [{ type: 'required', message: 'Tell us your name' }],
          email: [{ type: 'required', message: 'We need an email to reply to' }, { type: 'email' }],
          phone: [{ type: 'ukPhone' }],
          message: [{ type: 'required', message: 'What can we help with?' }, { type: 'minLength', value: 10, message: 'A little more detail helps' }],
        },
      });
    }
  </script>
</Base>
