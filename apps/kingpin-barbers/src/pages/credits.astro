---
import Base from '@/layouts/Base.astro';
---
<Base title="Image credits" description="Image sources for this demonstration website." noindex>
  <section class="bg-chalk text-ink">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-20">
      <h1 class="display-lg">Image credits</h1>
      <p class="mt-6 text-lg text-ink/80">Photography on this demonstration site was generated for the project (AI-assisted) and depicts no real people or premises. Replace with the business's own photography before launch — see the README for how.</p>
      <p class="mt-4 text-ink/70">Typefaces: Anton, Space Grotesk and JetBrains Mono, served locally under the SIL Open Font License.</p>
    </div>
  </section>
</Base>
