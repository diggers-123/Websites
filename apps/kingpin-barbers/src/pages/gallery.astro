---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { gallery, img } from '@/images';
import { site } from '@/site.config';
---
<Base title="Gallery" description="Recent cuts, fades, shaves and the shop itself — Kingpin Barber Co., Call Lane, Leeds.">
  <section class="bg-ink text-chalk">
    <div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="mono-label text-volt mb-3">The work</p>
        <h1 class="display-xl">Gallery</h1>
      </div>
      <p class="max-w-sm text-chalk/80">More every week on <a class="underline text-volt" href={site.social.instagram} rel="noopener">Instagram</a>. Tag us and we'll share it.</p>
    </div>
    <div class="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8 pb-20 grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4 auto-rows-[40vw] sm:auto-rows-[30vw] lg:auto-rows-[20vw]">
      {gallery.map((g, i) => (
        <figure class:list={['relative border-[3px] border-chalk overflow-hidden group', g.wide && 'col-span-2']} data-reveal data-reveal-delay={(i % 4) * 60}>
          <Image src={img(g.key)} alt={g.alt} widths={[480, 800, 1200]} sizes={g.wide ? '(min-width:1024px) 50vw, 100vw' : '(min-width:1024px) 25vw, 50vw'} class="absolute inset-0 h-full w-full object-cover grayscale group-hover:grayscale-0 transition-[filter] duration-500" />
          <figcaption class="absolute bottom-0 left-0 right-0 bg-ink/90 text-chalk font-mono text-xs px-3 py-2 translate-y-full group-hover:translate-y-0 group-focus-within:translate-y-0 transition-transform">
            <span class="text-volt">{String(i + 1).padStart(2, '0')}</span> {g.alt}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
