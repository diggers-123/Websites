---
import '@/styles/theme.css';
import Head from '@site/core/components/Head.astro';
import DemoBanner from '@site/core/components/DemoBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site.config';
interface Props { title?: string; description?: string; image?: string; schema?: unknown[]; noindex?: boolean; hideBookBar?: boolean }
const { title, description, image, schema, noindex, hideBookBar = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><Head {site} {title} {description} {image} {schema} {noindex} /></head>
  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <DemoBanner {site} />
    <Header />
    <main id="main" class="flex-1" tabindex="-1"><slot /></main>
    <Footer />
    {!hideBookBar && (<><div class="sm:hidden fixed bottom-0 inset-x-0 z-40 p-2 bg-coal"><a href={site.primaryCta.href} class="btn btn-volt w-full">{site.primaryCta.label}</a></div><div class="sm:hidden h-[68px]" aria-hidden="true"></div></>)}
    <script>
      import { initReveal, initMobileNav } from '@site/core/components/reveal';
      initReveal();
      initMobileNav({ button: '[data-nav-toggle]', panel: '[data-nav-panel]' });
      // Count-ups
      const els = document.querySelectorAll<HTMLElement>('[data-count]');
      if (els.length && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return; io.unobserve(e.target);
          const el = e.target as HTMLElement; const target = Number(el.dataset.count); const suffix = el.dataset.suffix ?? ''; const start = performance.now();
          const tick = (t: number) => { const p = Math.min(1, (t - start) / 1200); const v = Math.round(target * (1 - Math.pow(1 - p, 3))); el.textContent = v + suffix; if (p < 1) requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        }), { threshold: 0.5 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
