---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { hoursLines } from '@site/core';
const lines = hoursLines(site);
const mapsQuery = encodeURIComponent(`${site.address.line1}, ${site.address.town} ${site.address.postcode}`);
---
<Base title="Contact" description={`Forge Personal Training, ${site.address.line1}, Cardiff ${site.address.postcode}. ${site.phone}. Free parking; five minutes from Cardiff Central.`}>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-20 grid lg:grid-cols-2 gap-12">
    <div><p class="kicker text-cobalt">Contact</p><h1 class="display-xl mt-3">Say hello.</h1><p class="mt-4 text-coal/80 max-w-md">Quickest is to <a class="underline" href="/book">book a free consult</a>. For anything else:</p>
      <dl class="mt-8 grid gap-5"><div><dt class="kicker text-mute">Phone</dt><dd class="font-display text-2xl mt-1"><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd></div><div><dt class="kicker text-mute">Email</dt><dd class="mt-1 break-all"><a class="underline" href={`mailto:${site.email}`}>{site.email}</a></dd></div><div><dt class="kicker text-mute">Studio</dt><dd class="mt-1 not-italic">{site.address.line1}, {site.address.town} {site.address.postcode}<br /><a class="underline text-sm" href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener">Directions ↗</a> · free parking</dd></div><div><dt class="kicker text-mute">Hours</dt><dd class="mt-1 text-sm">{lines.map((l) => <span class="block">{l.days}: {l.time}</span>)}</dd></div></dl>
    </div>
    <form class="card p-6 sm:p-8 grid gap-4" data-contact-form name="contact" method="post" novalidate>
      <h2 class="display-md">Send a message</h2>
      <div class="grid sm:grid-cols-2 gap-4"><div><label class="label" for="c-name">Name</label><input class="field" id="c-name" name="name" autocomplete="name" required /><span data-error-for="name" hidden></span></div><div><label class="label" for="c-phone">Phone</label><input class="field" id="c-phone" name="phone" type="tel" autocomplete="tel" /><span data-error-for="phone" hidden></span></div></div>
      <div><label class="label" for="c-email">Email</label><input class="field" id="c-email" name="email" type="email" autocomplete="email" required /><span data-error-for="email" hidden></span></div>
      <div><label class="label" for="c-msg">Message</label><textarea class="field" id="c-msg" name="message" rows="5" required></textarea><span data-error-for="message" hidden></span></div>
      <p class="hidden" aria-hidden="true"><label>Leave empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
      <div class="flex items-center gap-4 flex-wrap"><button type="submit" class="btn btn-cobalt">Send</button><p data-form-status role="status" aria-live="polite" class="text-sm"></p></div>
    </form>
  </section>
  <script>
    import { enhanceForm } from '@site/core';
    import { site } from '@/site.config';
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (form) enhanceForm(form, { config: site.forms, formName: 'contact', rules: { name: [{ type: 'required', message: 'Your name' }], email: [{ type: 'required', message: 'An email to reply to' }, { type: 'email' }], phone: [{ type: 'ukPhone' }], message: [{ type: 'required', message: 'What can I help with?' }, { type: 'minLength', value: 10, message: 'A little more detail helps' }] } });
  </script>
</Base>
