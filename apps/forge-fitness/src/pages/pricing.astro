---
import Base from '@/layouts/Base.astro';
import { site } from '@/site.config';
import { faqSchema } from '@site/core';
const cats = [...new Set(site.services.map((s) => s.category))];
const faqs = site.faqs.filter((f) => /expire|cancellation|How often/.test(f.q));
---
<Base title="Pricing" description="Personal training £55 a session, 10 sessions £480, 20 for £880. Small group £15 or £95 unlimited. Online coaching £120 a month. Free consultation first." schema={[faqSchema(faqs)]}>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-10"><p class="kicker text-cobalt">Pricing</p><h1 class="display-xl mt-3">Straight numbers.</h1><p class="mt-4 text-coal/80 max-w-xl">No joining fee, no contract beyond the block you buy. Blocks pause for holidays and injuries.</p></section>
  {cats.map((c) => <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-10 border-t-[3px] border-coal/10 grid lg:grid-cols-[1fr_3fr] gap-8"><h2 class="display-lg">{c}</h2><div class="grid md:grid-cols-3 gap-6">{site.services.filter((s) => s.category === c).map((s) => <div class="card p-5 flex flex-col"><h3 class="display-sm">{s.name}</h3><p class="font-display text-3xl mt-2">{s.price}</p><p class="text-sm text-coal/75 mt-2 flex-1">{s.summary}</p><ul class="mt-3 text-sm grid gap-1">{s.includes?.map((x) => <li class="flex gap-2"><span class="text-cobalt font-bold">+</span>{x}</li>)}</ul>{s.bookable && <a href="/book" class="btn btn-volt mt-4 !py-2 !text-sm self-start">Book</a>}</div>)}</div></section>)}
  <section class="bg-bone-2 py-16"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1fr_2fr] gap-10"><h2 class="display-lg">Small print</h2><dl class="divide-y-[3px] divide-coal/10">{faqs.map((f) => <div class="py-5"><dt class="display-sm">{f.q}</dt><dd class="mt-2 text-coal/80">{f.a}</dd></div>)}</dl></div></section>
</Base>
