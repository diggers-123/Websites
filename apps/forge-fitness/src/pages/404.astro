---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 py-24 min-h-[60vh] flex flex-col justify-center"><p class="kicker text-cobalt">404</p><h1 class="display-xl mt-3">Missed rep.</h1><p class="mt-4 text-coal/80 max-w-md">That page doesn't exist. Reset and go again.</p><div class="mt-7 flex gap-3 flex-wrap"><a href="/" class="btn btn-cobalt">Home</a><a href="/book" class="btn btn-volt">Book a consult</a></div></section>
</Base>
