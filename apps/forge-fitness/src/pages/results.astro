---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site, results } from '@/site.config';
import { img } from '@/images';
---
<Base title="Results" description="What Forge clients achieve: first 100 kg deadlifts, pain-free backs, strength after fifty. Fictional results for demonstration.">
  <section class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 pt-12 lg:pt-20 pb-10 flex flex-wrap items-end justify-between gap-6"><div><p class="kicker text-cobalt">Results</p><h1 class="display-xl mt-3">Numbers, then people.</h1></div><p class="kicker text-mute">Fictional results for demonstration</p></section>
  <section class="bg-cobalt text-white cut-both py-[10vw]"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-8">{results.map((r) => { const m = r.stat.match(/^(\d+)(.*)$/); return <div class="border-l-[3px] border-volt pl-4"><p class="stat" data-count={m ? m[1] : undefined} data-suffix={m ? m[2] : ''}>{r.stat}</p><p class="mt-3 text-white/80 max-w-[18ch]">{r.label}</p></div>; })}</div></section>
  <section class="py-16 lg:py-24"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1fr_1fr] gap-10 items-center">
    <div class="relative aspect-[4/5] max-h-[600px] cut-br"><Image src={img('client')} alt="A client, out of breath and grinning after a set" widths={[640, 1024, 1400]} sizes="(min-width:1024px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" /></div>
    <div class="grid gap-8">{site.testimonials.map((t, i) => <figure class="card p-5" data-reveal data-reveal-delay={i * 70}><blockquote class="font-display uppercase text-[1.05rem] leading-snug">“{t.quote}”</blockquote><figcaption class="kicker text-mute mt-3">{t.name} · {t.context}</figcaption></figure>)}</div>
  </div></section>
  <section class="bg-coal text-bone py-16"><div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-6"><h2 class="display-lg">Your turn.</h2><a href="/book" class="btn btn-volt">Book a free consult</a></div></section>
</Base>
